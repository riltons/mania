{
  "name": "domino",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@rainbow-me/animated-charts",
          "react-native-chart-kit",
          "date-fns",
          "sharp",
          "styled-components"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "start:prod": "cross-env ENVFILE=.env.production expo start --no-dev --minify",
    "android:release": "expo run:android --variant release",
    "ios:release": "expo run:ios --configuration Release"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.1",
    "@rainbow-me/animated-charts": "^1.0.0-alpha.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.49.4",
    "@types/styled-components": "^5.1.34",
    "@types/styled-components-react-native": "^5.2.5",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.1.0",
    "expo": "^53.0.11",
    "expo-contacts": "~14.2.5",
    "expo-font": "~13.3.1",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-navigation-bar": "~4.2.5",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.8",
    "expo-updates": "~0.28.14",
    "expo-web-browser": "~14.1.6",
    "jest-expo": "~52.0.6",
    "node-fetch": "^2.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-iap": "^12.16.2",
    "react-native-paper": "^5.13.1",
    "react-native-paper-dates": "^0.22.34",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "sharp": "^0.33.5",
    "styled-components": "^6.1.15",
    "victory-native": "^41.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^12.0.7",
    "cross-env": "^7.0.3",
    "eas-cli": "^16.10.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.5",
    "react-test-renderer": "18.3.1",
    "supabase": "^2.15.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
